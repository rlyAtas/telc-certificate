<!doctype html>
<html lang="<%= messages.meta.htmlLang %>" dir="<%= messages.meta.dir %>">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <title><%= messages.common.pageTitle %></title>
  <link rel="stylesheet" href="/styles.css">
</head>
<body>
  <div class="wrap">
    <div class="card">

      <section class="section-card page-header">
        <h1 class="page-header__title"><%= messages.common.pageHeaderTitle %></h1>
      </section>

      <section class="section-card language-picker">
        <%
          const languageIcons = {
            de: '🇩🇪',
            en: '🇬🇧',
            fr: '🇫🇷',
            es: '🇪🇸',
            ru: '🇷🇺',
            uk: '🇺🇦',
            ar: '🇸🇦',
          };
        %>
        <nav class="language-picker__list" aria-label="<%= messages.language.label %>">
          <% supportedLanguages.forEach((code) => { %>
            <a
              class="language-picker__link <%= language === code ? 'language-picker__link--active' : '' %>"
              href="/?lang=<%= code %>"
              lang="<%= code %>"
              hreflang="<%= code %>"
              title="<%= messages.language.options[code] %>"
              aria-label="<%= messages.language.options[code] %>"
            >
              <span class="language-picker__icon"><%= languageIcons[code] %></span>
            </a>
          <% }) %>
        </nav>
      </section>

      <%- include('partials/info-card', {
        infoIcon: '🔎',
        infoLabel: messages.index.introLabel,
        infoParagraphs: [messages.index.introParagraph],
      }) %>

      <%- include('partials/progress', {
        progressTexts: messages.progress,
        steps: [
          'active',
          'todo',
          'todo',
          'todo',
        ],
      }) %>

      <form class="section-card home-form" method="post" action="/subscribe" novalidate>
        <%- include('partials/section-heading', {
          headingIcon: '📝',
          headingText: messages.index.formHeading,
        }) %>

        <label class="home-form__label"><%= messages.index.userNumberLabel %> <span class="home-form__required">*</span></label>
        <input class="home-form__input" name="userNumber" value="<%= values.userNumber || '' %>" />
        <% if (errors.userNumber) { %>
          <div class="home-form__error"><%= errors.userNumber %></div>
        <% } %>

        <label class="home-form__label"><%= messages.index.birthDateLabel %> <span class="home-form__required">*</span></label>
        <input class="home-form__input" type="date" name="birthDate" value="<%= values.birthDate || '' %>" inputmode="numeric"/>
        <% if (errors.birthDate) { %>
          <div class="home-form__error"><%= errors.birthDate %></div>
        <% } %>

        <label class="home-form__label"><%= messages.index.examDateLabel %> <span class="home-form__required">*</span></label>
        <input class="home-form__input" type="date" name="examDate" value="<%= values.examDate || '' %>" inputmode="numeric"/>
        <% if (errors.examDate) { %>
          <div class="home-form__error"><%= errors.examDate %></div>
        <% } %>

        <label class="home-form__label"><%= messages.index.emailLabel %> <span class="home-form__required">*</span></label>
        <input class="home-form__input" type="email" name="email" value="<%= values.email || '' %>" />
        <% if (errors.email) { %>
          <div class="home-form__error"><%= errors.email %></div>
        <% } %>

        <input type="hidden" name="language" value="<%= language %>">

        <button class="home-form__submit" type="submit"><%= messages.index.submitButton %></button>
      </form>

      <%- include('partials/contact-card', {
        contact: messages.contact,
      }) %>

    </div>
  </div>
</body>
</html>
