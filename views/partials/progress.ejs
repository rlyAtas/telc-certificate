<%
  const stepsList = Array.isArray(steps) ? steps : [];
  const localizedProgress = typeof progressTexts === 'object' ? progressTexts : null;
  const emptyStepText = {
    todo: '',
    active: '',
    done: '',
  };

  const stepTitleByNumber = {
    1: localizedProgress?.step1 ?? emptyStepText,
    2: localizedProgress?.step2 ?? emptyStepText,
    3: localizedProgress?.step3 ?? emptyStepText,
    4: localizedProgress?.step4 ?? emptyStepText,
  };

  const progressHeading = localizedProgress?.heading ?? '';
%>
<section class="section-card progress" aria-label="<%= progressHeading %>">
  <%- include('section-heading', {
    headingIcon: '📍',
    headingText: progressHeading,
  }) %>

  <ol class="progress__list">
    <% stepsList.forEach((item, index) => {
      const rawState = typeof item === 'string' ? item : 'todo';
      const state = rawState === 'done' || rawState === 'active' ? rawState : 'todo';
      const stepNumber = index + 1;
      const autoTitle =
        stepNumber && stepTitleByNumber[stepNumber]
          ? `${stepNumber}. ${stepTitleByNumber[stepNumber][state]}`
          : '';
      const title = autoTitle;
    %>
      <li class="progress__item progress__item--<%= state %>">
        <span class="progress__item-marker" aria-hidden="true"></span>
        <div>
          <p class="progress__item-title"><%= title %></p>
        </div>
      </li>
    <% }) %>
  </ol>
</section>
