<!doctype html>
<html lang="<%= messages.meta.htmlLang %>" dir="<%= messages.meta.dir %>">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <title><%= messages.common.pageTitle %></title>
  <link rel="stylesheet" href="/styles.css">
</head>
<body>
  <div class="wrap">
    <div class="card">
      <section class="section-card page-header">
        <h1 class="page-header__title"><%= messages.common.pageHeaderTitle %></h1>
      </section>

      <%
        const infoUrl = typeof homeUrl === 'string' && homeUrl.trim() ? homeUrl : '/';
      %>

      <%- include('partials/info-card', {
        infoIcon: '⚠️',
        infoLabel: messages.hint.label,
        infoParagraphs: [message],
        infoUrl,
        infoUrlText: messages.hint.backToHome,
      }) %>

      <%- include('partials/contact-card', {
        contact: messages.contact,
      }) %>

    </div>
  </div>
</body>
</html>
