<!doctype html>
<html lang="<%= messages.meta.htmlLang %>" dir="<%= messages.meta.dir %>">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <title><%= messages.common.pageTitle %></title>
  <link rel="stylesheet" href="/styles.css">
</head>
<body>
  <div class="wrap">
    <div class="card">
      <section class="section-card page-header">
        <h1 class="page-header__title"><%= messages.common.pageHeaderTitle %></h1>
      </section>

      <%- include('partials/progress', {
        progressTexts: messages.progress,
        steps: [
          'done',
          'done',
          'active',
          'todo',
        ],
      }) %>

      <%- include('partials/info-card', {
        infoIcon: '✅',
        infoLabel: messages.confirm.introLabel,
        infoParagraphs: messages.confirm.introParagraphs,
        infoUrl: urlStatus,
        infoUrlText: messages.confirm.statusButton,
      }) %>

      <%- include('partials/contact-card', {
        contact: messages.contact,
      }) %>
    </div>
  </div>
</body>
</html>
