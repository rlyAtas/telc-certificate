<!doctype html>
<html lang="<%= messages.meta.htmlLang %>" dir="<%= messages.meta.dir %>">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <title><%= messages.common.pageTitle %></title>
  <link rel="stylesheet" href="/styles.css">
</head>
<body>
  <div class="wrap">
    <div class="card">
      <section class="section-card page-header">
        <h1 class="page-header__title"><%= messages.common.pageHeaderTitle %></h1>
      </section>
      
      <%
        const statusMap = {
          ACTIVE: {
            badge: messages.status.badges.active,
            icon: '🕒',
            message: messages.status.messages.active,
          },
          CERTIFICATE_FOUND: {
            badge: messages.status.badges.found,
            icon: '✅',
            message: messages.status.messages.found,
          },
          CHECKING_EXPIRED: {
            badge: messages.status.badges.completed,
            icon: 'ℹ️',
            message: messages.status.messages.completed,
          },
        };

        const statusView = statusMap[status] ?? {
          badge: messages.status.badges.unknown,
          icon: 'ℹ️',
          message: messages.status.messages.unknown,
        };

        const progressMap = {
          ACTIVE: {
            step1: 'done',
            step2: 'done',
            step3: 'active',
            step4: 'todo',
          },
          CERTIFICATE_FOUND: {
            step1: 'done',
            step2: 'done',
            step3: 'done',
            step4: 'done',
          },
          CHECKING_EXPIRED: {
            step1: 'done',
            step2: 'done',
            step3: 'done',
            step4: 'done',
          },
        };

        const progressView = progressMap[status] ?? {
          step1: 'done',
          step2: 'done',
          step3: 'active',
          step4: 'todo',
        };

        const safeUserNumber = typeof userNumber === 'string' && userNumber.trim()
          ? userNumber.trim()
          : '-';
        const safeExamDate = typeof examDateText === 'string' && examDateText.trim()
          ? examDateText.trim()
          : '-';
      %>

      <%- include('partials/progress', {
        progressTexts: messages.progress,
        steps: [
          progressView.step1,
          progressView.step2,
          progressView.step3,
          progressView.step4,
        ],
      }) %>

      <%- include('partials/info-card', {
        infoIcon: statusView.icon,
        infoLabel: statusView.badge,
        infoParagraphs: [
          statusView.message,
          `${messages.status.participantNumberLabel}: ${safeUserNumber}`,
          `${messages.status.examDateLabel}: ${safeExamDate}`,
        ],
        infoUrl: certificateUrl || '',
        infoUrlText: certificateUrl ? messages.status.certificateButton : '',
      }) %>

      <%- include('partials/info-card', {
        infoIcon: '☕',
        infoLabel: messages.status.supportLabel,
        infoParagraphs: [
          messages.status.supportMessage,
        ],
        infoUrl: donationUrl,
        infoUrlText: messages.status.supportButton,
      }) %>

      <%- include('partials/contact-card', {
        contact: messages.contact,
      }) %>

    </div>
  </div>
</body>
</html>
